        <mxCell id="flow7" value="reads kubeconfig / socket path" style="endArrow=classic;html=1;rounded=0;strokeColor=#D97706;strokeWidth=2;dashed=1;endFill=1;fontSize=9;fontStyle=2;fontColor=#92400E;" edge="1" parent="1" source="kubectl" target="kubeconfig">
