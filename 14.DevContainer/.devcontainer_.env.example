# .devcontainer/.env.example
# Copy this file to .env.local and update with your values
# This file is loaded by post-start.sh and .devcontainer/post-create.sh

##############################################################################
# AZURE CONFIGURATION (for OIDC & Terraform Remote Backend)
##############################################################################

# Azure Subscription ID (required for terraform backend)
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Azure Tenant ID (required for OIDC)
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Azure Client ID (for OIDC authentication)
# This is your Service Principal: demo-github-azure-oidc-connection
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Enable OIDC authentication (for GitHub Actions)
# ARM_USE_OIDC=true

# Use Azure AD for authentication
# ARM_USE_AZUREAD=true

# Use Azure AD for storage (Blob Storage authentication)
# ARM_STORAGE_USE_AZUREAD=true

# Storage account name for Terraform backend
# STORAGE_ACCOUNT_NAME=mystorageaccount

# Resource group for Terraform backend
# BACKEND_RESOURCE_GROUP=my-terraform-backend-rg

# Storage container for Terraform state
# BACKEND_STORAGE_CONTAINER=tfstate

##############################################################################
# AWS CONFIGURATION (for AWS MCP servers and resources)
##############################################################################

# AWS Region (default for MCP pricing server: us-east-1)
# AWS_REGION=ap-southeast-2

# AWS Profile to use (if using named profiles)
# AWS_PROFILE=default

# AWS Access Key ID (alternative to ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# AWS Secret Access Key
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# AWS Account ID (for reference)
# AWS_ACCOUNT_ID=123456789012

##############################################################################
# TERRAFORM CONFIGURATION
##############################################################################

# Terraform Log Level (DEBUG, INFO, WARN, ERROR)
# TF_LOG=INFO

# Log file path for Terraform
# TF_LOG_PATH=.terraform-logs/terraform.log

# Terraform Parallelism (number of resources to manage in parallel)
# TF_PARALLELISM=4

# Backend configuration file (for remote state)
# TF_BACKEND_CONFIG_FILE=backend-azure.hcl

##############################################################################
# GITHUB CONFIGURATION (for GitHub Actions integration)
##############################################################################

# GitHub Personal Access Token (if needed for API calls)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Repository Owner (your username or org name)
# GITHUB_OWNER=mrbalraj007

# GitHub Repository Name
# GITHUB_REPO=Terraform-Drift-Detection

# GitHub Actions Environment (dev, staging, prod)
# GITHUB_ACTIONS_ENV=dev

##############################################################################
# SLACK INTEGRATION (for drift detection alerts)
##############################################################################

# Slack Incoming Webhook URL for terraform-drift-alerts channel
# Get this from: Slack App → Incoming Webhooks → Create New Webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# Slack channel name (override if needed, usually #terraform-drift-alerts)
# SLACK_CHANNEL=#terraform-drift-alerts

# Slack user ID for mentions (optional, for @mentions in alerts)
# SLACK_USER_ID=U00000000

##############################################################################
# DEVELOPMENT ENVIRONMENT
##############################################################################

# Editor for git commit messages
# EDITOR=nano

# Default pager
# PAGER=less

# Development environment (dev, staging, prod)
# ENVIRONMENT=dev

# Debug mode (set to 1 to enable verbose logging)
# DEBUG=0

##############################################################################
# OPTIONAL: MCP SERVER CONFIGURATION
##############################################################################

# Enable specific MCP servers (if using custom configurations)
# MCP_TERRAFORM_ENABLED=true
# MCP_AWS_CORE_ENABLED=true
# MCP_AWS_EKS_ENABLED=true
# MCP_AWS_PRICING_ENABLED=true

##############################################################################
# OPTIONAL: PRE-COMMIT HOOKS
##############################################################################

# Skip pre-commit hooks (not recommended, only for testing)
# SKIP=terraform_fmt,checkov

##############################################################################
# NOTES:
# ------
# 1. DO NOT commit .env.local to git (it's gitignored)
# 2. Keep sensitive values like tokens and credentials secure
# 3. For local testing: use az login and aws configure
# 4. For GitHub Actions: use OIDC federated credentials
# 5. Use Azure Key Vault for storing sensitive values in production
##############################################################################
