<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="AWS Bedrock RAG Architecture">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- User -->
        <mxCell id="user" value="User / Application" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="50" y="300" width="140" height="80" as="geometry"/>
        </mxCell>

        <!-- API Layer -->
        <mxCell id="api" value="API Layer / Bedrock Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="250" y="300" width="200" height="80" as="geometry"/>
        </mxCell>

        <!-- Bedrock -->
        <mxCell id="bedrock" value="Amazon Bedrock (LLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="500" y="300" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Retriever -->
        <mxCell id="retriever" value="Retriever (Semantic Search)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Vector DB -->
        <mxCell id="vector" value="Amazon OpenSearch (Vector DB)" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- S3 -->
        <mxCell id="s3" value="Amazon S3 (Dataset)" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="800" y="450" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Embedding -->
        <mxCell id="embed" value="Titan Embedding Model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="500" y="450" width="220" height="80" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="e1" edge="1" parent="1" source="user" target="api" style="strokeColor=#0000FF;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" edge="1" parent="1" source="api" target="bedrock" style="strokeColor=#0000FF;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" edge="1" parent="1" source="bedrock" target="retriever" style="strokeColor=#FF0000;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" edge="1" parent="1" source="retriever" target="vector" style="strokeColor=#FF0000;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5" edge="1" parent="1" source="vector" target="bedrock" style="strokeColor=#00AA00;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" edge="1" parent="1" source="s3" target="embed" style="strokeColor=#FFA500;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e7" edge="1" parent="1" source="embed" target="vector" style="strokeColor=#FFA500;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
