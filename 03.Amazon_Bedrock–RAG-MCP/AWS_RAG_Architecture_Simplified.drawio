        <mxCell id="workflow-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;fontSize=9;align=left;padding=12;shadow=0;fontFamily=Courier New;" value="&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;b&gt;WORKFLOW STEPS&lt;br&gt;&lt;/b&gt;&lt;br&gt;1️⃣ Confluence documents indexed by KB&lt;br&gt;2️⃣ Claude Agent queries via MCP Server&lt;br&gt;3️⃣ MCP Server calls Bedrock KB Retriever&lt;br&gt;4️⃣ KB retrieves relevant document context&lt;br&gt;5️⃣ Documents converted to vectors via Titan V2&lt;br&gt;6️⃣ Vector search in OpenSearch Serverless&lt;br&gt;7️⃣ LLM generates response using context&lt;br&gt;8️⃣ Response returned to agent &amp;amp; user&lt;/font&gt;" vertex="1">
